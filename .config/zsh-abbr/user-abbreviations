# editor / directory
abbr ".."="cd .."
abbr "..."="cd ../.."
abbr "vi"="nvim"
abbr "e"="exit"

# docker
abbr "dc"="docker-compose"

# mise
abbr "m"="mise"
abbr "mr"="mise run"

# git
abbr "g"="git"
abbr "ga"="git add"
abbr "gd"="git diff"
abbr "gs"="git switch"
abbr "gp"="git pull"
abbr "gb"="git branch"
abbr "gst"="git status"
abbr "gco"="git checkout"
abbr "gf"="git fetch -p"
abbr "gc"="git commit"
abbr "gw"="git worktree"

# other tools
abbr "c"="claude"
# difit: dn=now（コミット前）/ dl=last（直前のコミット）/ dp=PR 全体（mise の alias）
abbr "d"="difit"
abbr "dn"="difit ."
abbr "dl"="difit HEAD"
abbr "lg"="lazygit"
abbr "lq"="lazysql"
abbr "z"="zellij"
abbr "h"="herdr"
